{
  "$comment": "AgentOS: на старте сессии подхватываем незавершённую работу одной строкой.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/resume.sh --announce --quiet",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentctl resume --announce --quiet",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
